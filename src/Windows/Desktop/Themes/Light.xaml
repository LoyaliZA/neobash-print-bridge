<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="NpbCanvasBrush" Color="#EDEDF6" />
    <SolidColorBrush x:Key="NpbSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NpbWellBrush" Color="#F3F1FA" />
    <SolidColorBrush x:Key="NpbStrokeBrush" Color="#E4E0F0" />
    <SolidColorBrush x:Key="NpbInkBrush" Color="#1C1B29" />
    <SolidColorBrush x:Key="NpbMutedBrush" Color="#5E5B73" />
    <SolidColorBrush x:Key="NpbIndigoBrush" Color="#3D4BFF" />
    <SolidColorBrush x:Key="NpbIndigoPressedBrush" Color="#323ED4" />
    <SolidColorBrush x:Key="NpbIndigoSoftBrush" Color="#EEEDFC" />
    <SolidColorBrush x:Key="NpbReadyBrush" Color="#0F7A45" />
    <SolidColorBrush x:Key="NpbReadySoftBrush" Color="#E7F6EE" />
    <SolidColorBrush x:Key="NpbPausedBrush" Color="#7953A6" />
    <SolidColorBrush x:Key="NpbWarnBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="NpbWarnSoftBrush" Color="#FDF2E4" />
    <SolidColorBrush x:Key="NpbQuietBrush" Color="#F4F2F8" />

    <Style x:Key="NpbCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NpbSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NpbStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="NpbPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NpbIndigoBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NpbQuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NpbIndigoBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>

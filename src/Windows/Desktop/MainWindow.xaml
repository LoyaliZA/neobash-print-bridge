<Window
    x:Class="Neobash.PrintBridge.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Neobash Print Bridge">
    <Grid Background="{StaticResource NpbCanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="20,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource NpbIndigoBrush}">
                <FontIcon Glyph="&#xE749;" Foreground="White" FontSize="16" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Neobash Print Bridge" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="BrandSubtitle" Text="Centro de dispositivos" FontSize="12" Foreground="{StaticResource NpbMutedBrush}" />
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="Nav" Grid.Row="1"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            BackRequested="OnBack"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            CompactPaneLength="72"
            ItemInvoked="OnNavigate">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="Inicio">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="printers" Content="Impresoras">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE749;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="print" Content="Imprimir">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE956;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="jobs" Content="Trabajos">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="connections" Content="Conexiones">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="settings" Content="Ajustes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

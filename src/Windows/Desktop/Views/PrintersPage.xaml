<Page
    x:Class="Neobash.PrintBridge.Desktop.PrintersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neobash.PrintBridge.Desktop"
    Background="{StaticResource NpbCanvasBrush}">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="16">
            <TextBlock Text="Mis impresoras" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Spacing="8">
                <TextBox x:Name="SearchBox" PlaceholderText="Buscar por nombre" TextChanged="OnFilter" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Todas" Click="OnFilterClick" Tag="all" />
                    <Button Content="Físicas" Click="OnFilterClick" Tag="physical" />
                    <Button Content="Virtual" Click="OnFilterClick" Tag="virtual" />
                    <Button Content="Actualizar" Style="{StaticResource NpbQuietButton}" Click="OnRefresh" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="EmptyText" Text="No hay colas que coincidan con esta búsqueda." Foreground="{StaticResource NpbMutedBrush}" Visibility="Collapsed" />
            <ItemsControl x:Name="List">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" ItemHeight="280" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceCardModel">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Click="OnOpen" Tag="{x:Bind QueueName}">
                            <Border Style="{StaticResource NpbCard}" Margin="0,0,16,16">
                                <StackPanel Spacing="10">
                                    <local:DeviceArt Category="{x:Bind Art}" />
                                    <TextBlock Text="{x:Bind QueueName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NpbInkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource NpbMutedBrush}" />
                                    <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource NpbIndigoBrush}" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

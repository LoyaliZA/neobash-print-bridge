<Page
    x:Class="Neobash.PrintBridge.Desktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="16" MaxWidth="760">
            <TextBlock Text="Ajustes" FontSize="28" FontWeight="SemiBold" />
            <Border Style="{StaticResource NpbCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Apariencia" FontWeight="SemiBold" />
                    <TextBlock Text="El tema claro es el de esta entrega. El grafito se traducirá después con los mismos componentes." TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
                    <TextBlock x:Name="ThemeText" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource NpbCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Entorno" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="EnvironmentText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource NpbCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Diagnóstico" FontWeight="SemiBold" />
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" />
                    <TextBlock Text="Las marcas timing del arranque viven en diagnostic.log. No se suman ni se sustituyen. Esta pantalla no inventa una cifra nueva." TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
                    <TextBlock x:Name="Warnings" TextWrapping="Wrap" />
                    <Button Content="Abrir carpeta de registros" Style="{StaticResource NpbPrimaryButton}" HorizontalAlignment="Left" Click="OnOpenLogs" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource NpbCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Colas y controladores" FontWeight="SemiBold" />
                    <TextBlock x:Name="Queues" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="Neobash.PrintBridge.Desktop.ManualPrintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Padding="28" Spacing="16" MaxWidth="1100" HorizontalAlignment="Center">
            <TextBlock Text="Imprimir un documento" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Style="{StaticResource NpbCard}">
                <StackPanel Spacing="12">
                    <Button x:Name="PickButton" Content="Seleccionar PDF" Style="{StaticResource NpbPrimaryButton}" Click="OnPick" />
                    <TextBlock x:Name="PathText" Text="Ningún PDF seleccionado" TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="DestinationBox" Header="Destino" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="OnDestination" />
                    <TextBlock x:Name="DestinationText" TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
                    <NumberBox x:Name="CopiesBox" Header="Copias" Value="1" Minimum="1" Maximum="999" SpinButtonPlacementMode="Compact" Width="160" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource NpbCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Vista previa" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousButton" Content="←" AutomationProperties.Name="Página anterior" Click="OnPrevious" />
                        <TextBlock x:Name="PageText" Text="Selecciona un documento" VerticalAlignment="Center" />
                        <Button x:Name="NextButton" Content="→" AutomationProperties.Name="Página siguiente" Click="OnNext" />
                        <Button Content="−" AutomationProperties.Name="Alejar vista previa" Click="OnZoomOut" />
                        <Button Content="+" AutomationProperties.Name="Acercar vista previa" Click="OnZoomIn" />
                    </StackPanel>
                    <ScrollViewer Height="400" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource NpbWellBrush}">
                        <Canvas x:Name="PaperCanvas" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White" Margin="12" Visibility="Collapsed">
                            <Canvas x:Name="PrintableCanvas">
                                <Image x:Name="Preview" Stretch="Fill" />
                            </Canvas>
                            <Rectangle x:Name="PrintableOutline" Stroke="{StaticResource NpbIndigoBrush}" StrokeThickness="1" StrokeDashArray="4,3" />
                        </Canvas>
                    </ScrollViewer>
                    <TextBlock x:Name="PreviewNote" Text="El contorno indica el área imprimible reportada por el controlador." TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
                </StackPanel>
            </Border>
            <Expander Header="Opciones avanzadas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <CheckBox x:Name="AllPages" Content="Todas las páginas" IsChecked="True" />
                    <TextBox x:Name="FirstPage" Header="Desde" InputScope="Number" />
                    <TextBox x:Name="LastPage" Header="Hasta" InputScope="Number" />
                    <ComboBox x:Name="OrientationBox" Header="Orientación" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnLayoutChanged">
                        <ComboBoxItem Content="Vertical" /><ComboBoxItem Content="Horizontal" />
                    </ComboBox>
                    <ComboBox x:Name="ScaleBox" Header="Escala" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OnLayoutChanged">
                        <ComboBoxItem Content="Tamaño real" /><ComboBoxItem Content="Ajustar al área imprimible" /><ComboBoxItem Content="Porcentaje" />
                    </ComboBox>
                    <TextBox x:Name="PercentBox" Header="Porcentaje del tamaño físico del PDF" Text="100" TextChanged="OnPercentChanged" InputScope="Number" />
                    <TextBlock Text="Para opciones propias del equipo, abre Configuración de Windows → Impresoras y escáneres → tu impresora → Preferencias de impresión. Los cambios allí pueden afectar trabajos posteriores." TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Padding="28,12" Spacing="8" Background="{StaticResource NpbCanvasBrush}">
            <Button x:Name="PrintButton" Content="Imprimir" Style="{StaticResource NpbPrimaryButton}" HorizontalAlignment="Stretch" Click="OnPrint" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
    </StackPanel>
    </Grid>
</Page>

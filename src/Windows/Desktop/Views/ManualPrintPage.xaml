<Page
    x:Class="Neobash.PrintBridge.Desktop.ManualPrintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource NpbCard}">
            <StackPanel Spacing="12">
                <TextBlock Text="Documento" FontSize="22" FontWeight="SemiBold" />
                <Button Content="Elegir PDF" Style="{StaticResource NpbQuietButton}" HorizontalAlignment="Left" Click="OnPick" />
                <TextBlock x:Name="PathText" Text="Ningún PDF elegido." TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
                <TextBlock x:Name="PageText" Foreground="{StaticResource NpbMutedBrush}" TextWrapping="Wrap" />
                <Image x:Name="Preview" MaxHeight="520" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="La vista previa muestra una página. El posible recorte se comprueba al imprimir, con el mismo cálculo del envío." TextWrapping="Wrap" Foreground="{StaticResource NpbMutedBrush}" />
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource NpbCard}">
            <ScrollViewer>
                <StackPanel Spacing="10">
                    <TextBlock Text="Impresión" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="DestinationText" TextWrapping="Wrap" />
                    <TextBox x:Name="CopiesBox" Header="Copias" Text="1" />
                    <CheckBox x:Name="AllPages" Content="Todas las páginas" IsChecked="True" />
                    <TextBox x:Name="FirstPage" Header="Desde" />
                    <TextBox x:Name="LastPage" Header="Hasta" />
                    <ComboBox x:Name="OrientationBox" Header="Orientación" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Vertical" />
                        <ComboBoxItem Content="Horizontal" />
                    </ComboBox>
                    <ComboBox x:Name="ScaleBox" Header="Escala" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Tamaño real" />
                        <ComboBoxItem Content="Ajustar al área imprimible" />
                        <ComboBoxItem Content="Porcentaje" />
                    </ComboBox>
                    <TextBox x:Name="PercentBox" Header="Porcentaje del tamaño físico del PDF" />
                    <Button x:Name="PrintButton" Content="Imprimir" Style="{StaticResource NpbPrimaryButton}" HorizontalAlignment="Stretch" Click="OnPrint" />
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

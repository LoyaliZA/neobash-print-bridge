<Page
    x:Class="Neobash.PrintBridge.Desktop.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neobash.PrintBridge.Desktop"
    Background="{StaticResource NpbCanvasBrush}">
    <ScrollViewer>
        <StackPanel Padding="28" Spacing="24">
            <Border Background="{StaticResource NpbIndigoBrush}" CornerRadius="20" Padding="28">
                <StackPanel Spacing="8">
                    <TextBlock Text="TU ESPACIO DE IMPRESIÓN" Foreground="White" FontSize="12" CharacterSpacing="80" />
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" Foreground="White" FontSize="14" TextWrapping="Wrap" Opacity="0.92" />
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="Mis impresoras" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Actualizar" Style="{StaticResource NpbQuietButton}" HorizontalAlignment="Right" Click="OnRefresh" />
            </Grid>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource NpbMutedBrush}" TextWrapping="Wrap" />

            <TextBlock Text="Físicas" FontWeight="SemiBold" />
            <TextBlock x:Name="PhysicalEmpty" Text="Windows todavía no anuncia colas físicas." Foreground="{StaticResource NpbMutedBrush}" Visibility="Collapsed" />
            <ItemsControl x:Name="PhysicalList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" ItemHeight="280" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceCardModel">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnOpen" Tag="{x:Bind QueueName}">
                            <Border Style="{StaticResource NpbCard}" Margin="0,0,16,16">
                                <StackPanel Spacing="12">
                                    <local:DeviceArt Category="{x:Bind Art}" />
                                    <TextBlock Text="{x:Bind QueueName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NpbInkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource NpbMutedBrush}" />
                                    <Border Background="{StaticResource NpbReadySoftBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource NpbReadyBrush}" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Virtual" FontWeight="SemiBold" />
            <TextBlock x:Name="VirtualEmpty" Text="La impresora virtual no se comprobó en este arranque." Foreground="{StaticResource NpbMutedBrush}" Visibility="Collapsed" />
            <ItemsControl x:Name="VirtualList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" ItemHeight="280" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceCardModel">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Click="OnOpen" Tag="{x:Bind QueueName}">
                            <Border Style="{StaticResource NpbCard}" Margin="0,0,16,16">
                                <StackPanel Spacing="12">
                                    <local:DeviceArt Category="{x:Bind Art}" />
                                    <TextBlock Text="{x:Bind QueueName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource NpbInkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource NpbMutedBrush}" />
                                    <Border Background="{StaticResource NpbIndigoSoftBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource NpbIndigoBrush}" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Acciones rápidas" FontSize="22" FontWeight="SemiBold" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnPrint" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="88" Background="{StaticResource NpbSurfaceBrush}" CornerRadius="20" BorderBrush="{StaticResource NpbStrokeBrush}">
                    <StackPanel Spacing="8"><FontIcon Glyph="&#xE956;" Foreground="{StaticResource NpbIndigoBrush}" /><TextBlock Text="Imprimir PDF" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Column="1" Click="OnPrinters" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="88" Background="{StaticResource NpbSurfaceBrush}" CornerRadius="20" BorderBrush="{StaticResource NpbStrokeBrush}">
                    <StackPanel Spacing="8"><FontIcon Glyph="&#xE8FD;" Foreground="{StaticResource NpbIndigoBrush}" /><TextBlock Text="Destinos" HorizontalAlignment="Center" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Click="OnAccess" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="88" Background="{StaticResource NpbSurfaceBrush}" CornerRadius="20" BorderBrush="{StaticResource NpbStrokeBrush}">
                    <StackPanel Spacing="8"><FontIcon Glyph="&#xE72E;" Foreground="{StaticResource NpbIndigoBrush}" /><TextBlock Text="Accesos" HorizontalAlignment="Center" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

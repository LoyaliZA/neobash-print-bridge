<UserControl
    x:Class="Neobash.PrintBridge.Desktop.DeviceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Neobash.PrintBridge.Desktop">
    <Button x:Name="OpenButton" Width="304" Height="248" Padding="20" CornerRadius="20"
        Background="{StaticResource NpbSurfaceBrush}" BorderBrush="{StaticResource NpbStrokeBrush}"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
        UseSystemFocusVisuals="True" Click="OnOpen">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="48" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <local:DeviceArt x:Name="Art" />
            <TextBlock Grid.Row="1" Text="{Binding QueueName}" FontSize="18" FontWeight="SemiBold"
                TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding QueueName}" />
            <TextBlock Grid.Row="2" Text="{Binding KindLabel}" FontSize="12" Foreground="{StaticResource NpbMutedBrush}" />
            <TextBlock x:Name="StatusLabel" Grid.Row="3" Text="{Binding Status}" FontSize="12" VerticalAlignment="Bottom" />
        </Grid>
    </Button>
</UserControl>

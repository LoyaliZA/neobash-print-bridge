    <Compile Include="..\..\src\Windows\Desktop\DesktopHost.cs" Link="Desktop\DesktopHost.cs" />
    <Compile Include="..\..\src\Windows\Desktop\StartupClock.cs" Link="Desktop\StartupClock.cs" />
    <Compile Include="..\..\src\Windows\Desktop\JobPhaseText.cs" Link="Desktop\JobPhaseText.cs" />
  </ItemGroup>

